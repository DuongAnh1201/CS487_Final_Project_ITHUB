# Copy to .env (never commit .env). Every setting uses the ITHUB_ prefix.

# Local: a SQLite file. Production (Supabase): paste the "Session pooler" connection string as is,
# e.g. postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# See docs/DEPLOY.md.
ITHUB_DATABASE_URL=sqlite:///./ithub.db
# Required in production: a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
ITHUB_SECRET_KEY=change-me-in-production
ITHUB_SESSION_TIMEOUT_MINUTES=30
ITHUB_MAX_FAILED_LOGINS=5
ITHUB_LOCKOUT_MINUTES=15
ITHUB_BCRYPT_ROUNDS=12

# Browser origins allowed to call the API (CORS): comma-separated or a JSON list. Set to your frontend URL(s).
ITHUB_CORS_ORIGINS=http://localhost:5173

# First Admin, created only when the users table is empty.
# If ITHUB_ADMIN_PASSWORD is unset, a random temporary password is generated and logged once at WARNING
# ("Initial admin password: ..."). Either way it must be changed at the first password login.
# Do not reuse a password that is written down anywhere public.
ITHUB_ADMIN_FULL_NAME=System Administrator
ITHUB_ADMIN_EMAIL=admin@sfbu.edu
ITHUB_ADMIN_SCHOOL_ID=ADMIN-0001
# ITHUB_ADMIN_PASSWORD=

# Google sign-in is OFF until configured. See README.md, "Enabling Google sign-in".
# Option 1 (used for the MVP): Firebase Authentication. Values from Firebase console → Project settings →
# Your apps → Web app. They are public (the login page uses them). Firebase wins if both options are set.
# ITHUB_FIREBASE_PROJECT_ID=it-hub-a7cf9
# ITHUB_FIREBASE_API_KEY=AIzaSyBcLbZiRoLhVPhB1xUZO-xSVAt9JUC7S3c
# ITHUB_FIREBASE_AUTH_DOMAIN=it-hub-a7cf9.firebaseapp.com
# ITHUB_FIREBASE_APP_ID=1:295459341438:web:c4ff539f0a207accd3442f
# Option 2: Google Identity Services directly.
# Comma-separated list or JSON list of OAuth client IDs (type: Web application).
# ITHUB_GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Only accept accounts from this domain (leave unset to accept any Google account). With Firebase it is
# checked against the verified email's domain.
# ITHUB_GOOGLE_HOSTED_DOMAIN=sfbu.edu

# Notification emails through Resend are OFF until both the key and the sender are set.
# See README.md, "Enabling email (Resend)". Never commit a real key.
# ITHUB_RESEND_API_KEY=re_xxxxxxxxxxxx
# ITHUB_EMAIL_FROM=IT Inventory Tracker <noreply@yourdomain.edu>
# ITHUB_EMAIL_REPLY_TO=it-help@yourdomain.edu
# Signing secret of the Resend webhook (enables POST /webhooks/resend):
# ITHUB_RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Where the frontend pages are served (the backend serves them at /app); used in the email "Open" link:
ITHUB_APP_BASE_URL=http://127.0.0.1:8000/app
