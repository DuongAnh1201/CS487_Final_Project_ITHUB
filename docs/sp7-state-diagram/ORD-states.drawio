></mxGeometry></mxCell><mxCell id="s11" value="createOrder()&lt;br&gt;[no open order]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="530" /></Array><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s12" value="receiveOrder()&lt;br&gt;[quantity ≥ threshold]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="530" /></Array><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s13" value="order arrived or cancelled&lt;br&gt;[quantity &amp;lt; threshold]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="420" /><mxPoint x="830" y="420" /></Array><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s14" value="stock added on Assets page&lt;br&gt;[quantity ≥ threshold]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="130" /><mxPoint x="300" y="130" /></Array><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s15" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Quantity and threshold belong to Item / Consumable (Assets page).&lt;br&gt;• OrderManager and NotificationService are the StockMonitor observers.&lt;br&gt;• Retiring an item is modelled on the Assets page." style="shape=note;html=1;whiteSpace=wrap;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="620" width="400" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>