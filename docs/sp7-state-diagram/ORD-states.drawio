abelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="270" /><mxPoint x="1110" y="152" /></Array><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s23" value="[qty = remaining]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s7" target="s10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="440" /></Array><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s10" target="s14"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s12" target="s15"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s26" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Every transition writes an AuditRecord through AuditLog.record().&lt;br&gt;• A quantity ≤ 0 or greater than the remaining amount is rejected;&lt;br&gt;&amp;nbsp;&amp;nbsp;the order stays in its current state and an error is shown.&lt;br&gt;• Only one open order (Requested, Ordered, Partially Arrived) per item." style="shape=note;html=1;whiteSpace=wrap;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="460" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="Item Stock Level" name="Item Stock Level"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="760" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s1" value="&lt;b&gt;Item Stock Level – State Diagram (watched by StockMonitor)&lt;/b&gt;" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#000000;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="900" height="30" as="geometry" /></mxCell><mxCell id="s2" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="245" width="30" height="30" as="geometry" /></mxCell><mxCell id="s3" value="In Stock" style="swimlane;rounded=1;arcSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=30;horizontal=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#1ba1e2;strokeColor=#006EAF;swimlaneFillColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="200" width="240" height="110" as="geometry" /></mxCell><mxCell id="s4" value="entry / clear low-stock flag" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontColor=#000000;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="s3"><mxGeometry x="0" y="30" width="240" height="80" as="geometry" /></mxCell><mxCell id="s5" value="Low Stock" style="swimlane;rounded=1;arcSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=30;horizontal=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#1ba1e2;strokeColor=#006EAF;swimlaneFillColor=#ffffff;fontColor=#fff