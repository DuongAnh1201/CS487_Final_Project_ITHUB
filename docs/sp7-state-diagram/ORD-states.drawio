unded=1;arcSize=12;fontStyle=1;align=center;verticalAlign=top;startSize=30;horizontal=1;collapsible=0;html=1;whiteSpace=wrap;fillColor=#1ba1e2;strokeColor=#006EAF;swimlaneFillColor=#ffffff;fontColor=#ffffff;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="220" height="90" as="geometry" /></mxCell><mxCell id="s13" value="entry / record cancel reason" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontColor=#000000;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="s12"><mxGeometry x="0" y="30" width="220" height="60" as="geometry" /></mxCell><mxCell id="s14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1555" y="425" width="30" height="30" as="geometry" /></mxCell><mxCell id="s15" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1000" y="550" width="30" height="30" as="geometry" /></mxCell><mxCell id="s16" value="createOrder()&lt;br&gt;[no open order for item]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s17" value="placeOrder()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s5"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="s18" value="cancelOrder()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=open;endSize=10;strokeColor=#333333;strokeWidth=1.3;fontC