</mxCell><mxCell id="CLS-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="CLS-schedule_imports-r0" target="CLS-schedule_entries-r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="1154.0"/><mxPoint x="724" y="1208.0"/></Array></mxGeometry></mxCell><mxCell id="CLS-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="CLS-room_checks-r0" target="CLS-room_check_results-r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="124.0"/><mxPoint x="1410" y="646.0"/></Array></mxGeometry></mxCell><mxCell id="CLS-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="CLS-schedule_imports-r0" target="CLS-schedule_import_errors-r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1410" y="1154.0"/><mxPoint x="1410" y="1506.0"/></Array></mxGeometry></mxCell><mxCell id="CLS-note" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;• FKs marked → users reference users.user_id (Login &amp;amp; Users page); not drawn to keep the diagram readable&lt;br&gt;• IDs AUTOINCREMENT, never reused (BR-01) · nothing is deleted: DELETE triggers on classrooms, room_equipment, schedule_entries (BR-02)&lt;br&gt;• One classroom per Location: UNIQUE classrooms(location_id) · deactivation blocked while equipment is installed or future classes exist (BR-18)&lt;br&gt;• One room per item: UNIQUE index on room_equipment(item_id) WHERE removed_at IS NULL · a move = close the record + open a new one; removed records are read-only&lt;br&gt;• No overlapping ACTIVE classes in the same room, day and term: overlap trigger on schedule_entries (BR-19) · IMPORT rows need import_id, MANUAL rows have none&lt;br&gt;• room_checks, room_check_results and schedule_import_errors are append-only · a new room check updates classrooms.last_checked_at (trigger)&lt;br&gt;• Not stored: room status (view v_classroom_status, DD-CLS-02) · check overdue (view v_rooms_check_overdue: never checked or &amp;gt; 7 days, BR-20)" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1760" width="1420" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ISS" name="Issue Logs (ISS) – ER Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1090" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ISS-title" value="Issue Logs (ISS) – ER Diagram" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="ISS-issues" value="issues" style="shape=table;startSize=38;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#1BA1E2;strokeColor=#006EAF;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="568" height="742" as="geometry"/></mxCell><mxCell id="ISS-issues-r0" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#BBBBBB;html=1;" vertex="1" parent="ISS-issues"><mxGeometr