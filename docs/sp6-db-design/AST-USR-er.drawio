tSize=13;" vertex="1" parent="USR-audit_records-r1"><mxGeometry x="268" width="300" height="32" as="geometry"><mxRectangle width="300" height="32" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="USR-e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="USR-users-r0" target="USR-loans-r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="134.0"/><mxPoint x="625" y="166.0"/></Array></mxGeometry></mxCell><mxCell id="USR-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="USR-users-r0" target="USR-loans-r2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="134.0"/><mxPoint x="645" y="198.0"/></Array></mxGeometry></mxCell><mxCell id="USR-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="USR-users-r0" target="USR-sessions-r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="134.0"/><mxPoint x="1270" y="166.0"/></Array></mxGeometry></mxCell><mxCell id="USR-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=12;endSize=12;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1.5;" edge="1" parent="1" source="USR-users-r0" target="USR-audit_records-r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="134.0"/><mxPoint x="1300" y="446.0"/></Array></mxGeometry></mxCell><mxCell id="USR-note" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;• role IN (ADMIN, STUDENT_ASSISTANT) · status IN (ACTIVE, LOCKED, DEACTIVATED) · locked_until required when status = LOCKED (FR-USR-07)&lt;br&gt;• school_email (case-insensitive) and school_id UNIQUE · only the bcrypt hash is stored (NFR-USR-01) · users are never deleted (trigger, BR-02)&lt;br&gt;• Every page&#x27;s *_by and assigned_to columns reference users.user_id · created_by / updated_by also point back to users&lt;br&gt;• App layer: lock for 15 min after 5 failures, password ≥ 10 chars with letters and digits (BR-06), at least one active Admin (BR-05)&lt;br&gt;• A session is expired when last_activity_at is more than 30 minutes ago (NFR-USR-02)" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="720" width="1900" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>