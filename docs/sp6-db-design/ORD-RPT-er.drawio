" as="geometry"><Array as="points"><mxPoint x="1060" y="211" /><mxPoint x="1060" y="333" /></Array></mxGeometry></mxCell><mxCell id="e172" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=12;startSize=12;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERoneToMany;endArrow=ERmandOne;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="e91" target="e29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="603" /><mxPoint x="1100" y="133" /></Array></mxGeometry></mxCell><mxCell id="e173" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=12;startSize=12;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERmany;endArrow=ERmandOne;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="e95" target="e121"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1630" y="629" /><mxPoint x="1630" y="336" /></Array></mxGeometry></mxCell><mxCell id="e174" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=1.3;endSize=12;startSize=12;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;startArrow=ERmany;endArrow=ERmandOne;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="e134" target="e121"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e175" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;• Report inheritance uses one table: report_type tells DailyReport&lt;br&gt;&amp;nbsp;&amp;nbsp;from MonthlySummaryReport; unused columns stay NULL.&lt;br&gt;• One monthly summary per month: UNIQUE (month, year)&lt;br&gt;&amp;nbsp;&amp;nbsp;WHERE report_type = &#x27;MONTHLY&#x27;.&lt;br&gt;• A summary reads that month&#x27;s reports and orders by date,&lt;br&gt;&amp;nbsp;&amp;nbsp;so no link tables are needed.&lt;br&gt;• audit_records.entity_type + entity_id point to any table (e.g. &#x27;Order&#x27;, 42),&lt;br&gt;&amp;nbsp;&amp;nbsp;so entity_id has no foreign key. Records are never updated or deleted." style="shape=note;html=1;whiteSpace=wrap;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="600" width="470" height="160" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>